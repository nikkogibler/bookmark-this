{
  "version": 1,
  "owner_label": "you",
  "agentic_platform": "codex",
  "source_bookmark_paths": [],
  "ingestion": {
    "enabled": false,
    "sources": [],
    "deduplicate": true,
    "preserve_legacy_folders": true,
    "delete_sources": false
  },
  "timezone": "Europe/Rome",
  "link_style": "markdown",
  "paths": {
    "bookmarks": "bookmarks",
    "views": "views",
    "collections": "collections",
    "assets": "bookmark-assets",
    "index": "index.md"
  },
  "categories": [
    {
      "slug": "research",
      "label": "Research",
      "description": "Sources and material to investigate"
    },
    {
      "slug": "tools",
      "label": "Tools",
      "description": "Software and utilities worth revisiting"
    }
  ],
  "capture": {
    "depth": "standard",
    "personal_relevance": "always",
    "inference_label": "Inference, not confirmed:",
    "retain_safe_original_url": false,
    "strip_tracking_parameters": true
  },
  "context": {
    "mode": "conversation-only",
    "sources": [
      {
        "scope": "session",
        "label": "Current session"
      }
    ],
    "store_excerpts": false
  },
  "navigation": {
    "generate_category_views": true,
    "generate_tag_views": true
  },
  "visualizer": {
    "enabled": true,
    "path": "visualizer/index.html",
    "editing_enabled": true
  },
  "rich_media": {
    "enabled": true,
    "cache_preview_images": true,
    "allow_remote_video_embeds": false,
    "allow_remote_stock_charts": false,
    "stock_chart_provider": "tradingview"
  }
}
